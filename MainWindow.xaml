<Window x:Class="AnaliseDemonstrativoTISS.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnaliseDemonstrativoTISS"
        xmlns:operadoras="clr-namespace:AnaliseDemonstrativoTISS.Operadoras"
        mc:Ignorable="d"
        Title="Análise de Demonstrativo TISS" Height="700" Width="980"
        MinHeight="700" MinWidth="780"
        Icon="Assets/app.ico"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <operadoras:OneBasedIndexConverter x:Key="OneBasedIndexConverter" />
    </Window.Resources>

    <!--
    Crédito ícone do app:
    https://www.flaticon.com/br/icones-gratis/conta-corrente
    Conta-corrente ícones criados por PIXARTIST - Flaticon
    -->

    <Grid Margin="18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilterPanelColumn" Width="1*" />
                <ColumnDefinition x:Name="ResultPanelColumn" Width="4*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="FilterPanelBorder" Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="FilterPanelSubtitleText"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"
                                   Text="Última Atualização do App: 10/05/2026"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <ToggleButton x:Name="FilterPanelToggleButton"
                                      Grid.Column="1"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,0,0,8"
                                      Style="{StaticResource FilterPanelToggleButtonStyle}"
                                      Checked="FilterPanelToggleButton_Checked"
                                      Unchecked="FilterPanelToggleButton_Unchecked">
                            <!--
                            Crédito ícone do toggle:
                            https://www.flaticon.com/br/icones-gratis/setas
                            Setas ícones criados por Graphix Dxinerz - Flaticon
                            -->
                            <Image Source="Assets/toggle-arrows.png"
                                   Width="12"
                                   Height="12"
                                   Stretch="Uniform" />
                        </ToggleButton>
                    </Grid>

                    <Grid x:Name="FilterPanelContent" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Operadora de saúde"
                                   Style="{StaticResource FieldLabelStyle}" />

                        <ComboBox x:Name="OperadoraComboBox"
                                  Grid.Row="1"
                                  MinHeight="36"
                                  SelectedIndex="0"
                                  Margin="0,0,0,12"
                                  Style="{StaticResource InputComboBoxStyle}"
                                  SelectionChanged="OperadoraComboBox_SelectionChanged">
                            <ComboBoxItem Content="Amil" />
                            <ComboBoxItem Content="Cabesp" />
                            <ComboBoxItem Content="Caixa de Cubatão" />
                            <ComboBoxItem Content="Cassi" />
                            <ComboBoxItem Content="Economus" />
                            <ComboBoxItem Content="Geap" />
                            <ComboBoxItem Content="Petrobras" />
                            <ComboBoxItem Content="Sulamerica" />
                            <ComboBoxItem Content="Vivest" />
                        </ComboBox>

                        <TextBlock Grid.Row="2"
                                   Text="Arquivo"
                                   Style="{StaticResource FieldLabelStyle}" />

                        <Button Grid.Row="3"
                                x:Name="SelectXmlFileButton"
                                Content="Selecionar arquivo"
                                MinHeight="36"
                                Margin="0,0,0,12"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SelectXmlFileButton_Click" />

                        <TextBlock Grid.Row="4"
                                   Text="Campo para busca"
                                   Style="{StaticResource FieldLabelStyle}" />

                        <ComboBox x:Name="SearchFieldComboBox"
                                  Grid.Row="5"
                                  MinHeight="36"
                                  SelectedIndex="0"
                                  Margin="0,0,0,12"
                                  Style="{StaticResource InputComboBoxStyle}" />

                        <TextBlock Grid.Row="6"
                                   Text="Dados para filtragem"
                                   Style="{StaticResource FieldLabelStyle}" />

                        <TextBox x:Name="FilterValuesTextBox"
                                 Grid.Row="7"
                                 Margin="0,0,0,10"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />

                        <StackPanel Grid.Row="8" VerticalAlignment="Top">
                            <TextBlock Text="Você pode informar um ou vários filtros na mesma execução, um em cada linha."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />

                            <Button Content="Executar Busca"
                                    MinHeight="36"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ExecuteSearchButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              x:Name="ResultDataGrid"
                              AutoGenerateColumns="True"
                              AutoGeneratedColumns="ResultDataGrid_AutoGeneratedColumns"
                              LoadingRow="ResultDataGrid_LoadingRow"
                              IsReadOnly="True"
                              FrozenColumnCount="1"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              Style="{StaticResource ResultDataGridStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              PreviewMouseLeftButtonDown="ResultDataGrid_PreviewMouseLeftButtonDown"
                              PreviewKeyDown="ResultDataGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="52"
                                                    MinWidth="52"
                                                    MaxWidth="52"
                                                    CanUserSort="False"
                                                    CanUserReorder="False"
                                                    CanUserResize="False"
                                                    IsReadOnly="True">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ResultDataGridHeaderStyle}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>

                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <Button Content="⋮"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Width="30"
                                                Height="28"
                                                Padding="0"
                                                Margin="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Click="RowNumberHeaderMenuButton_Click"
                                                Style="{StaticResource HeaderMenuButtonStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent"
                                                PreviewMouseLeftButtonDown="RowNumberCell_PreviewMouseLeftButtonDown">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="#334155"
                                                       Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Tag}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
