<Window x:Class="AnaliseDemonstrativoTISS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnaliseDemonstrativoTISS"
        mc:Ignorable="d"
        Title="Análise de Demonstrativo TISS" Height="700" Width="980"
        MinHeight="700" MinWidth="780"
        Icon="Assets/code-xml.png"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Análise de Demonstrativo TISS"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#0F172A" />
                <TextBlock Text="Selecione a operadora, o arquivo XML e execute a busca para visualizar os dados em formato legível."
                           Margin="0,6,0,0"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Operadora de saúde"
                               Style="{StaticResource FieldLabelStyle}" />

                    <ComboBox x:Name="OperadoraComboBox"
                              Grid.Row="1"
                              MinHeight="36"
                              SelectedIndex="0"
                              Margin="0,0,0,12"
                              Style="{StaticResource InputComboBoxStyle}">
                        <ComboBoxItem Content="Amil" />
                        <ComboBoxItem Content="Cabesp" />
                        <ComboBoxItem Content="Caixa de Cubatão" />
                        <ComboBoxItem Content="Cassi" />
                        <ComboBoxItem Content="Economus" />
                        <ComboBoxItem Content="Geap" />
                        <ComboBoxItem Content="Petrobras" />
                        <ComboBoxItem Content="Sulamerica" />
                        <ComboBoxItem Content="Vivest" />
                    </ComboBox>

                    <TextBlock Grid.Row="2"
                               Text="Arquivo XML"
                               Style="{StaticResource FieldLabelStyle}" />

                    <Button Grid.Row="3"
                            x:Name="SelectXmlFileButton"
                            Content="Selecionar arquivo"
                            MinHeight="36"
                            Margin="0,0,0,12"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SelectXmlFileButton_Click" />

                    <TextBlock Grid.Row="4"
                               Text="Campo para busca"
                               Style="{StaticResource FieldLabelStyle}" />

                    <ComboBox x:Name="SearchFieldComboBox"
                              Grid.Row="5"
                              MinHeight="36"
                              SelectedIndex="0"
                              Margin="0,0,0,12"
                              Style="{StaticResource InputComboBoxStyle}">
                        <ComboBoxItem Content="Credencial" />
                        <ComboBoxItem Content="Nome" />
                        <ComboBoxItem Content="Senha" />
                    </ComboBox>

                    <TextBlock Grid.Row="6"
                               Text="Dados para filtragem"
                               Style="{StaticResource FieldLabelStyle}" />

                    <TextBox x:Name="FilterValuesTextBox"
                             Grid.Row="7"
                             Margin="0,0,0,10"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             Style="{StaticResource InputTextBoxStyle}"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />

                    <StackPanel Grid.Row="8" VerticalAlignment="Top">
                        <TextBlock Text="Você pode informar um ou vários filtros na mesma execução."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <Button Content="Executar Busca"
                                MinHeight="36"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ExecuteSearchButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DataGrid x:Name="ResultDataGrid"
                          AutoGenerateColumns="True"
                          AutoGeneratedColumns="ResultDataGrid_AutoGeneratedColumns"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          Style="{StaticResource ResultDataGridStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto" />
            </Border>
        </Grid>
    </Grid>
</Window>
